 using CalendarMcp.Core.Models;
+using System.Security.Cryptography;
 using Microsoft.Graph;
 using Microsoft.Graph.Models;
 
@@ -70,4 +71,40 @@ internal static class GraphAttachmentBuilder
                 attachment, cancellationToken: cancellationToken);
         }
     }
+
+    public static async Task<bool> AddToExistingDraftAsync(
+        GraphServiceClient graphClient,
+        string draftId,
+        OutboundEmailAttachment attachment,
+        CancellationToken cancellationToken)
+    {
+        var draft = await graphClient.Me.Messages[draftId].GetAsync(cancellationToken: cancellationToken)
+            ?? throw new InvalidOperationException("The draft was not found in this mailbox.");
+        if (draft.IsDraft != true)
+            throw new InvalidOperationException("The selected message is not an unsent draft.");
+
+        var file = (FileAttachment)Build([attachment]).Single();
+        var existing = await graphClient.Me.Messages[draftId].Attachments.GetAsync(
+            cancellationToken: cancellationToken);
+        foreach (var item in existing?.Value ?? [])
+        {
+            if (!string.Equals(item.Name, file.Name, StringComparison.OrdinalIgnoreCase))
+                continue;
+
+            var current = await graphClient.Me.Messages[draftId].Attachments[item.Id].GetAsync(
+                cancellationToken: cancellationToken) as FileAttachment;
+            if (current?.ContentBytes is null)
+                throw new InvalidOperationException(
+                    "A same-named attachment already exists but cannot be verified.");
+            if (!CryptographicOperations.FixedTimeEquals(
+                    SHA256.HashData(current.ContentBytes), SHA256.HashData(file.ContentBytes!)))
+                throw new InvalidOperationException(
+                    "A different attachment with the same name already exists on the draft.");
+            return false;
+        }
+
+        await graphClient.Me.Messages[draftId].Attachments.PostAsync(
+            file, cancellationToken: cancellationToken);
+        return true;
+    }
 }
