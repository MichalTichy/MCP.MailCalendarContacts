@@ -0,0 +1,54 @@
+using System.ComponentModel;
+using System.Text.Json;
+using CalendarMcp.Core.Models;
+using CalendarMcp.Core.Services;
+using ModelContextProtocol;
+using ModelContextProtocol.Server;
+
+namespace CalendarMcp.Core.Tools;
+
+[McpServerToolType]
+public sealed class AttachToDraftTool(
+    IAccountRegistry accountRegistry,
+    IProviderServiceFactory providerFactory,
+    GatewayAgentFileDownloader agentFileDownloader)
+{
+    [McpServerTool(Name = "attach_to_draft"), Description(
+        "Attach a file from a run-scoped Codex Gateway agentFileUrl to an existing unsent email draft. " +
+        "The message is never sent. Supported for Microsoft 365 and Outlook.com accounts. " +
+        "The operation is idempotent when the same file name and bytes are already attached.")]
+    public async Task<string> AttachToDraft(
+        [Description("Account containing the existing draft; obtain from list_accounts.")] string accountId,
+        [Description("Provider draft ID returned by save_draft. Never use a sent message ID.")] string draftId,
+        [Description("Run-scoped artifact URL returned by another MCP tool through Codex Gateway.")] string agentFileUrl)
+    {
+        if (string.IsNullOrWhiteSpace(accountId) || string.IsNullOrWhiteSpace(draftId))
+            throw new McpException("accountId and draftId are required.");
+
+        var account = await ToolGuard.RequireAccountAsync(
+            accountRegistry, accountId, AccountPermission.EmailSend);
+        var attachment = await agentFileDownloader.DownloadAsync(new OutboundEmailAttachment
+        {
+            AgentFileUrl = agentFileUrl
+        });
+        var provider = providerFactory.GetProvider(account.Provider);
+        try
+        {
+            var attached = await provider.AttachToDraftAsync(
+                account.Id, draftId, attachment);
+            return JsonSerializer.Serialize(new
+            {
+                success = true,
+                attached,
+                alreadyAttached = !attached,
+                draftReference = draftId,
+                accountUsed = account.Id,
+                fileName = attachment.Name
+            });
+        }
+        catch (NotSupportedException exception)
+        {
+            throw new McpException(exception.Message, exception);
+        }
+    }
+}
