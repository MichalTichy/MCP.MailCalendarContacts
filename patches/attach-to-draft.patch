new file mode 100644
index 0000000..d5bca4d
--- /dev/null
+++ b/src/CalendarMcp.Tests/Tools/AttachToDraftToolTests.cs
@@ -0,0 +1,74 @@
+using System.Net;
+using System.Security.Cryptography;
+using System.Text.Json;
+using CalendarMcp.Core.Models;
+using CalendarMcp.Core.Services;
+using CalendarMcp.Core.Tools;
+using CalendarMcp.Tests.Helpers;
+using Microsoft.Extensions.Configuration;
+using Rocks;
+
+namespace CalendarMcp.Tests.Tools;
+
+[TestClass]
+public sealed class AttachToDraftToolTests
+{
+    [TestMethod]
+    public async Task Attaches_gateway_file_to_existing_draft_without_sending()
+    {
+        var bytes = "invoice"u8.ToArray();
+        var account = TestData.CreateAccount(id: "riganti", provider: "microsoft365");
+        var registry = new IAccountRegistryCreateExpectations();
+        registry.Setups.GetAccountAsync("riganti").ReturnValue(Task.FromResult<AccountInfo?>(account));
+        var provider = new IProviderServiceCreateExpectations();
+        provider.Setups.AttachToDraftAsync(
+                "riganti", "draft-123", Arg.Any<OutboundEmailAttachment>(),
+                Arg.Any<CancellationToken>())
+            .ReturnValue(Task.FromResult(true));
+        var factory = new IProviderServiceFactoryCreateExpectations();
+        factory.Setups.GetProvider("microsoft365").ReturnValue(provider.Instance());
+        var downloader = new GatewayAgentFileDownloader(
+            new ClientFactory(new FileHandler(bytes)),
+            new ConfigurationBuilder().AddInMemoryCollection(new Dictionary<string, string?>
+            {
+                ["CalendarMcp:AgentFileOrigin"] = "http://gateway:8080"
+            }).Build());
+        var tool = new AttachToDraftTool(registry.Instance(), factory.Instance(), downloader);
+
+        var result = await tool.AttachToDraft(
+            "riganti", "draft-123",
+            "http://gateway:8080/_internal/mcp/artifacts/abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNO_0");
+        using var json = JsonDocument.Parse(result);
+
+        Assert.IsTrue(json.RootElement.GetProperty("attached").GetBoolean());
+        Assert.AreEqual("invoice.pdf", json.RootElement.GetProperty("fileName").GetString());
+        registry.Verify();
+        factory.Verify();
+        provider.Verify();
+    }
+
+    private sealed class ClientFactory(HttpMessageHandler handler) : IHttpClientFactory
+    {
+        public HttpClient CreateClient(string name) => new(handler);
+    }
+
+    private sealed class FileHandler(byte[] bytes) : HttpMessageHandler
+    {
+        protected override Task<HttpResponseMessage> SendAsync(
+            HttpRequestMessage request,
+            CancellationToken cancellationToken)
+        {
+            var response = new HttpResponseMessage(HttpStatusCode.OK)
+            {
+                Content = new ByteArrayContent(bytes)
+            };
+            response.Content.Headers.ContentDisposition =
+                new System.Net.Http.Headers.ContentDispositionHeaderValue("attachment")
+                {
+                    FileNameStar = "invoice.pdf"
+                };
+            response.Headers.Add("X-Content-SHA256", Convert.ToHexStringLower(SHA256.HashData(bytes)));
+            return Task.FromResult(response);
+        }
+    }
+}
