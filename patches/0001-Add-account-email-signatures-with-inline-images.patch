     }

+    private static EmailSignature? GetEmailSignatureProperty(JsonObject obj)
+    {
+        var signatureNode = obj["EmailSignature"]?.AsObject() ?? obj["emailSignature"]?.AsObject();
+        if (signatureNode is null) return null;
+
+        var imagesNode = signatureNode["Images"]?.AsArray() ?? signatureNode["images"]?.AsArray();
+        var images = new List<EmailSignatureImage>();
+        if (imagesNode is not null)
+        {
+            foreach (var node in imagesNode)
+            {
+                var image = node?.AsObject();
+                if (image is null) continue;
+                var contentId = GetStringProperty(image, "ContentId");
+                var name = GetStringProperty(image, "Name");
+                var contentType = GetStringProperty(image, "ContentType");
+                var base64Content = GetStringProperty(image, "Base64Content");
+                if (contentId is null || name is null || contentType is null || base64Content is null)
+                    continue;
+
+                images.Add(new EmailSignatureImage
+                {
+                    ContentId = contentId,
+                    Name = name,
+                    ContentType = contentType,
+                    Base64Content = base64Content
+                });
+            }
+        }
+
+        return new EmailSignature
+        {
+            Enabled = GetBoolProperty(signatureNode, "Enabled") ?? false,
+            Html = GetStringProperty(signatureNode, "Html") ?? "",
+            Text = GetStringProperty(signatureNode, "Text") ?? "",
+            Images = images
+        };
+    }
+
     private static bool? GetBoolProperty(JsonObject? obj, string pascalName)
     {
         if (obj is null) return null;
