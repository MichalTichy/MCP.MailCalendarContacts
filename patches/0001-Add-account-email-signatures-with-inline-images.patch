diff --git a/src/CalendarMcp.Core/Models/EmailSignature.cs b/src/CalendarMcp.Core/Models/EmailSignature.cs
new file mode 100644
index 0000000..013f2d0
--- /dev/null
+++ b/src/CalendarMcp.Core/Models/EmailSignature.cs
@@ -0,0 +1,29 @@
+namespace CalendarMcp.Core.Models;
+
+/// <summary>
+/// Account-owned signature appended to ordinary outbound messages.
+/// The agent supplies only the message body; signature content stays in the
+/// account configuration and is composed server-side.
+/// </summary>
+public sealed class EmailSignature
+{
+    public bool Enabled { get; init; }
+
+    /// <summary>HTML fragment appended to HTML messages.</summary>
+    public string Html { get; init; } = "";
+
+    /// <summary>Plain-text fallback appended to text messages.</summary>
+    public string Text { get; init; } = "";
+
+    /// <summary>Images referenced from <see cref="Html"/> through cid: URLs.</summary>
+    public List<EmailSignatureImage> Images { get; init; } = [];
+}
+
+/// <summary>An inline image owned by an email signature.</summary>
+public sealed class EmailSignatureImage
+{
+    public required string ContentId { get; init; }
+    public required string Name { get; init; }
+    public required string ContentType { get; init; }
+    public required string Base64Content { get; init; }
+}
