+<div class="card mb-4">
+    <div class="card-header"><strong>Email signature</strong></div>
+    <div class="card-body">
+        <div class="form-check form-switch mb-3">
+            <InputCheckbox class="form-check-input" @bind-Value="Model.SignatureEnabled" />
+            <label class="form-check-label">Append this signature to new messages, replies, and drafts</label>
+        </div>
+
+        <div class="mb-3">
+            <label class="form-label">HTML signature</label>
+            <InputTextArea class="form-control font-monospace" rows="8" @bind-Value="Model.SignatureHtml" />
+            <div class="form-text">Use email-safe HTML. Uploaded images are inserted as <code>cid:</code> references.</div>
+        </div>
+
+        <div class="mb-3">
+            <label class="form-label">Plain-text fallback</label>
+            <InputTextArea class="form-control" rows="4" @bind-Value="Model.SignatureText" />
+            <div class="form-text">Used for plain-text messages. If empty, text is derived from the HTML.</div>
+        </div>
+
+        <div class="mb-3">
+            <label class="form-label">Inline images</label>
+            <InputFile class="form-control" OnChange="UploadImagesAsync" accept="image/png,image/jpeg,image/gif" multiple />
+            <div class="form-text">PNG, JPEG, or GIF; at most 5 images, 1 MB per image, and 2 MB total.</div>
+        </div>
+
+        @if (_error is not null)
+        {
+            <div class="alert alert-danger py-2">@_error</div>
+        }
+
+        @if (Model.SignatureImages.Count > 0)
+        {
+            <div class="list-group mb-3">
+                @foreach (var image in Model.SignatureImages)
+                {
+                    <div class="list-group-item d-flex align-items-center gap-3">
+                        <img src="@ImageSource(image)" alt="" style="max-width: 120px; max-height: 56px" />
+                        <div class="flex-grow-1 overflow-hidden">
+                            <div class="fw-semibold text-truncate">@image.Name</div>
+                            <code>cid:@image.ContentId</code>
+                        </div>
+                        <button type="button" class="btn btn-sm btn-outline-danger"
+                                @onclick="() => RemoveImage(image)">Remove</button>
+                    </div>
+                }
+            </div>
+        }
+
+        @if (!string.IsNullOrWhiteSpace(Model.SignatureHtml))
+        {
+            <label class="form-label">Preview</label>
+            <iframe class="w-100 border rounded bg-white" style="min-height: 180px"
+                    sandbox srcdoc="@PreviewHtml"></iframe>
+        }
