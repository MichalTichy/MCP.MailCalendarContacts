@@ -0,0 +1,79 @@
+using CalendarMcp.Core.Models;
+using CalendarMcp.Core.Services;
+using CalendarMcp.Tests.Helpers;
+
+namespace CalendarMcp.Tests.Services;
+
+[TestClass]
+public class EmailCompositionServiceTests
+{
+    private static readonly EmailSignature Signature = new()
+    {
+        Enabled = true,
+        Html = "<strong>Michal</strong><img src=\"cid:logo\">",
+        Text = "Michal",
+        Images =
+        [
+            new EmailSignatureImage
+            {
+                ContentId = "logo",
+                Name = "logo.png",
+                ContentType = "image/png",
+                Base64Content = Convert.ToBase64String([1, 2, 3])
+            }
+        ]
+    };
+
+    private readonly EmailCompositionService _service = new();
+
+    [TestMethod]
+    public void Compose_Html_AppendsSignatureAndInlineImage()
+    {
+        var account = TestData.CreateAccount(emailSignature: Signature);
+
+        var result = _service.Compose(account, "<p>Hello</p>", "html");
+
+        StringAssert.Contains(result.Body, "<p>Hello</p>");
+        StringAssert.Contains(result.Body, "cid:logo");
+        Assert.IsTrue(result.SignatureApplied);
+        Assert.HasCount(1, result.Attachments!);
+        Assert.AreEqual("logo.png", result.Attachments![0].Name);
+    }
+
+    [TestMethod]
+    public void Compose_Text_UsesFallbackWithoutAttachingImages()
+    {
+        var account = TestData.CreateAccount(emailSignature: Signature);
+
+        var result = _service.Compose(account, "Hello", "text");
+
+        Assert.AreEqual("Hello\r\n\r\n-- \r\nMichal", result.Body);
+        Assert.IsNull(result.Attachments);
+        Assert.IsTrue(result.SignatureApplied);
+    }
+
+    [TestMethod]
+    public void Compose_Multipart_AppendsBothVariants()
+    {
+        var account = TestData.CreateAccount(emailSignature: Signature);
+
+        var result = _service.Compose(
+            account, "", "multipart", textBody: "Hello", htmlBody: "<p>Hello</p>");
+
+        StringAssert.Contains(result.TextBody!, "-- \r\nMichal");
+        StringAssert.Contains(result.HtmlBody!, "cid:logo");
+        Assert.HasCount(1, result.Attachments!);
+    }
+
+    [TestMethod]
+    public void Compose_IncludeSignatureFalse_LeavesMessageUntouched()
+    {
+        var account = TestData.CreateAccount(emailSignature: Signature);
+
+        var result = _service.Compose(account, "Body", "html", includeSignature: false);
+
+        Assert.AreEqual("Body", result.Body);
+        Assert.IsFalse(result.SignatureApplied);
+        Assert.IsNull(result.Attachments);
+    }
+}
