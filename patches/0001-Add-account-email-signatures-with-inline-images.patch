@@ -0,0 +1,109 @@
+using CalendarMcp.Core.Models;
+using CalendarMcp.HttpServer.BlazorAdmin;
+using Microsoft.AspNetCore.Components;
+using Microsoft.AspNetCore.Components.Forms;
+
+namespace CalendarMcp.HttpServer.Components.Shared;
+
+public partial class EmailSignatureEditor
+{
+    private const long MaxImageBytes = 1024 * 1024;
+    private const long MaxTotalImageBytes = 2 * 1024 * 1024;
+    private const int MaxImageCount = 5;
+    private static readonly HashSet<string> AllowedTypes =
+        ["image/png", "image/jpeg", "image/gif"];
+
+    [Parameter, EditorRequired]
+    public AccountFormBase Model { get; set; } = default!;
+
+    private string? _error;
+
+    private string PreviewHtml
+    {
+        get
+        {
+            var html = Model.SignatureHtml;
+            foreach (var image in Model.SignatureImages)
+                html = html.Replace($"cid:{image.ContentId}", ImageSource(image), StringComparison.OrdinalIgnoreCase);
+            return html;
+        }
+    }
+
+    private async Task UploadImagesAsync(InputFileChangeEventArgs args)
+    {
+        _error = null;
+        IReadOnlyList<IBrowserFile> files;
+        try
+        {
+            files = args.GetMultipleFiles(MaxImageCount);
+        }
+        catch (InvalidOperationException)
+        {
+            _error = $"A signature can contain at most {MaxImageCount} images.";
+            return;
+        }
+        if (Model.SignatureImages.Count + files.Count > MaxImageCount)
+        {
+            _error = $"A signature can contain at most {MaxImageCount} images.";
+            return;
+        }
+
+        foreach (var file in files)
+        {
+            if (!AllowedTypes.Contains(file.ContentType))
+            {
+                _error = $"'{file.Name}' is not a supported image type.";
+                return;
+            }
+            if (file.Size > MaxImageBytes)
+            {
+                _error = $"'{file.Name}' is larger than 1 MB.";
+                return;
+            }
+
+            var existingBytes = Model.SignatureImages.Sum(GetDecodedLength);
+            if (existingBytes + file.Size > MaxTotalImageBytes)
+            {
+                _error = "Signature images may use at most 2 MB in total.";
+                return;
+            }
+
+            await using var stream = file.OpenReadStream(MaxImageBytes);
+            using var memory = new MemoryStream();
+            await stream.CopyToAsync(memory);
+            var contentId = $"signature-{Guid.NewGuid():N}";
+            Model.SignatureImages.Add(new EmailSignatureImage
+            {
+                ContentId = contentId,
+                Name = file.Name,
+                ContentType = file.ContentType,
+                Base64Content = Convert.ToBase64String(memory.ToArray())
+            });
+            Model.SignatureHtml = $"{Model.SignatureHtml.TrimEnd()}\n<img src=\"cid:{contentId}\" alt=\"\">".TrimStart();
+        }
+    }
+
+    private void RemoveImage(EmailSignatureImage image)
+    {
+        Model.SignatureImages.Remove(image);
+        Model.SignatureHtml = Model.SignatureHtml.Replace(
+            $"<img src=\"cid:{image.ContentId}\" alt=\"\">", "", StringComparison.OrdinalIgnoreCase);
+    }
+
+    private static long GetDecodedLength(EmailSignatureImage image)
+    {
+        try
+        {
+            return string.IsNullOrWhiteSpace(image.Base64Content)
+                ? 0
+                : Convert.FromBase64String(image.Base64Content).LongLength;
+        }
+        catch (FormatException)
+        {
+            return 0;
+        }
+    }
+
+    private static string ImageSource(EmailSignatureImage image) =>
+        $"data:{image.ContentType};base64,{image.Base64Content}";
+}
