+    private static JsonNode? EmailSignatureToNode(EmailSignature? signature)
+    {
+        if (signature is null) return null;
+
+        return new JsonObject
+        {
+            ["Enabled"] = signature.Enabled,
+            ["Html"] = signature.Html,
+            ["Text"] = signature.Text,
+            ["Images"] = new JsonArray(signature.Images.Select(image => (JsonNode?)new JsonObject
+            {
+                ["ContentId"] = image.ContentId,
+                ["Name"] = image.Name,
+                ["ContentType"] = image.ContentType,
+                ["Base64Content"] = image.Base64Content
+            }).ToArray())
+        };
+    }
+
     private static JsonObject PermissionsToNode(AccountPermissions permissions)
     {
         var obj = new JsonObject();
