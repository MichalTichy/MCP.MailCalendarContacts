+    public static async Task AddToMessageAsync(
+        GraphServiceClient graphClient,
+        string messageId,
+        IReadOnlyList<OutboundEmailAttachment>? attachments,
+        CancellationToken cancellationToken)
+    {
+        if (attachments is not { Count: > 0 }) return;
+
+        foreach (var attachment in Build(attachments))
+        {
+            await graphClient.Me.Messages[messageId].Attachments.PostAsync(
+                attachment, cancellationToken: cancellationToken);
+        }
+    }
