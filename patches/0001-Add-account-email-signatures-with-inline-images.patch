@@ -0,0 +1,46 @@
+using System.Text;
+using CalendarMcp.Core.Models;
+using CalendarMcp.Core.Providers;
+using Microsoft.Graph.Models;
+using MimeKit;
+
+namespace CalendarMcp.Tests.Providers;
+
+[TestClass]
+public class InlineAttachmentBuilderTests
+{
+    private static OutboundEmailAttachment CreateInlineImage() => new()
+    {
+        Name = "logo.png",
+        ContentType = "image/png",
+        Base64Content = Convert.ToBase64String([1, 2, 3]),
+        IsInline = true,
+        ContentId = "signature-logo"
+    };
+
+    [TestMethod]
+    public void GraphBuilder_MarksSignatureImageInline()
+    {
+        var result = GraphAttachmentBuilder.Build([CreateInlineImage()]);
+
+        var attachment = (FileAttachment)result.Single();
+        Assert.IsTrue(attachment.IsInline);
+        Assert.AreEqual("signature-logo", attachment.ContentId);
+        Assert.AreEqual("image/png", attachment.ContentType);
+    }
+
+    [TestMethod]
+    public async Task MimeBuilder_EmitsContentIdAndInlineDisposition()
+    {
+        var body = MimeAttachmentBuilder.BuildBody(
+            "<p>Hello</p><img src=\"cid:signature-logo\">", "html", [CreateInlineImage()]);
+        var message = new MimeMessage { Body = body };
+        using var stream = new MemoryStream();
+
+        await message.WriteToAsync(stream);
+        var mime = Encoding.UTF8.GetString(stream.ToArray());
+
+        StringAssert.Contains(mime, "Content-Id: <signature-logo>");
+        StringAssert.Contains(mime, "Content-Disposition: inline");
+    }
+}
