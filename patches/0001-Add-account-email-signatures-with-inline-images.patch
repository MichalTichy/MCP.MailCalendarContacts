-        if (!string.IsNullOrWhiteSpace(attachment.ContentType)
+        if (attachment.IsInline)
+        {
+            MimeEntity resource;
+            if (!string.IsNullOrWhiteSpace(attachment.ContentType)
+                && ContentType.TryParse(attachment.ContentType, out var inlineType))
+            {
+                resource = builder.LinkedResources.Add(attachment.Name, bytes, inlineType);
+            }
+            else
+            {
+                resource = builder.LinkedResources.Add(attachment.Name, bytes);
+            }
+
+            resource.ContentId = attachment.ContentId;
+        }
+        else if (!string.IsNullOrWhiteSpace(attachment.ContentType)
             && ContentType.TryParse(attachment.ContentType, out var ct))
         {
             builder.Attachments.Add(attachment.Name, bytes, ct);
@@ -36,4 +51,28 @@ internal static class MimeAttachmentBuilder
             builder.Attachments.Add(attachment.Name, bytes);
         }
     }
+
+    public static MimeEntity BuildBody(
+        string body,
+        string bodyFormat,
+        IReadOnlyList<OutboundEmailAttachment>? attachments)
+    {
+        if (attachments is not { Count: > 0 })
+        {
+            return new TextPart(bodyFormat.Equals("text", StringComparison.OrdinalIgnoreCase)
+                ? MimeKit.Text.TextFormat.Plain
+                : MimeKit.Text.TextFormat.Html) { Text = body };
+        }
+
+        var builder = new BodyBuilder();
+        if (bodyFormat.Equals("text", StringComparison.OrdinalIgnoreCase))
+            builder.TextBody = body;
+        else
+            builder.HtmlBody = body;
+
+        foreach (var attachment in attachments)
+            Add(builder, attachment);
+
+        return builder.ToMessageBody();
+    }
 }
