diff --git a/src/CalendarMcp.Core/Services/EmailCompositionService.cs b/src/CalendarMcp.Core/Services/EmailCompositionService.cs
new file mode 100644
index 0000000..bc2df34
--- /dev/null
+++ b/src/CalendarMcp.Core/Services/EmailCompositionService.cs
@@ -0,0 +1,108 @@
+using System.Net;
+using CalendarMcp.Core.Models;
+
+namespace CalendarMcp.Core.Services;
+
+/// <summary>
+/// Deterministically appends the selected account's signature and turns its
+/// cid images into provider-neutral inline resources.
+/// </summary>
+public sealed class EmailCompositionService : IEmailCompositionService
+{
+    public ComposedEmailContent Compose(
+        AccountInfo account,
+        string body,
+        string bodyFormat,
+        IReadOnlyList<OutboundEmailAttachment>? attachments = null,
+        string? textBody = null,
+        string? htmlBody = null,
+        bool includeSignature = true)
+    {
+        var signature = account.EmailSignature;
+        if (!includeSignature || signature is not { Enabled: true } ||
+            (string.IsNullOrWhiteSpace(signature.Html) && string.IsNullOrWhiteSpace(signature.Text)))
+        {
+            return new ComposedEmailContent(body, textBody, htmlBody, attachments, false);
+        }
+
+        var format = bodyFormat.ToLowerInvariant();
+        var composedBody = body;
+        var composedText = textBody;
+        var composedHtml = htmlBody;
+
+        switch (format)
+        {
+            case "text":
+                composedBody = AppendText(body, ResolveText(signature));
+                break;
+            case "multipart":
+                composedText = AppendText(textBody ?? "", ResolveText(signature));
+                composedHtml = AppendHtml(htmlBody ?? "", ResolveHtml(signature));
+                break;
+            default:
+                composedBody = AppendHtml(body, ResolveHtml(signature));
+                break;
+        }
+
+        IReadOnlyList<OutboundEmailAttachment>? composedAttachments = attachments;
+        if (format is "html" or "multipart" && signature.Images.Count > 0)
+        {
+            var result = attachments?.ToList() ?? [];
+            foreach (var image in signature.Images)
+            {
+                if (string.IsNullOrWhiteSpace(image.ContentId) ||
+                    string.IsNullOrWhiteSpace(image.Name) ||
+                    string.IsNullOrWhiteSpace(image.Base64Content))
+                    continue;
+
+                result.Add(new OutboundEmailAttachment
+                {
+                    Name = image.Name,
+                    ContentType = image.ContentType,
+                    Base64Content = image.Base64Content,
+                    IsInline = true,
+                    ContentId = image.ContentId
+                });
+            }
+            composedAttachments = result;
+        }
+
+        return new ComposedEmailContent(
+            composedBody, composedText, composedHtml, composedAttachments, true);
+    }
+
+    private static string ResolveHtml(EmailSignature signature)
+    {
+        if (!string.IsNullOrWhiteSpace(signature.Html))
+            return signature.Html.Trim();
+
+        return WebUtility.HtmlEncode(signature.Text.Trim())
+            .Replace("\r\n", "<br>", StringComparison.Ordinal)
+            .Replace("\n", "<br>", StringComparison.Ordinal);
+    }
+
+    private static string ResolveText(EmailSignature signature) =>
+        !string.IsNullOrWhiteSpace(signature.Text)
+            ? signature.Text.Trim()
+            : StripHtml(signature.Html).Trim();
+
+    private static string AppendHtml(string body, string signature) =>
+        string.IsNullOrWhiteSpace(signature)
+            ? body
+            : $"{body}<br><br><div class=\"email-signature\">{signature}</div>";
+
+    private static string AppendText(string body, string signature) =>
+        string.IsNullOrWhiteSpace(signature)
+            ? body
+            : $"{body.TrimEnd()}\r\n\r\n-- \r\n{signature}";
+
+    private static string StripHtml(string html)
+    {
+        if (string.IsNullOrWhiteSpace(html)) return "";
+        var withLines = System.Text.RegularExpressions.Regex.Replace(
+            html, @"<(br|/p|/div|/li)\b[^>]*>", "\n",
+            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
+        var withoutTags = System.Text.RegularExpressions.Regex.Replace(withLines, @"<[^>]+>", "");
+        return WebUtility.HtmlDecode(withoutTags);
+    }
+}
