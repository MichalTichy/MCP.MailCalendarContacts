@@ -0,0 +1,59 @@
+using System.ComponentModel;
+using System.Text.Json;
+using CalendarMcp.Core.Services;
+using Microsoft.Extensions.Logging;
+using ModelContextProtocol;
+using ModelContextProtocol.Server;
+
+namespace CalendarMcp.Core.Tools;
+
+[McpServerToolType]
+public sealed class ReplyEmailTool(
+    IAccountRegistry accountRegistry,
+    IProviderServiceFactory providerFactory,
+    ILogger<ReplyEmailTool> logger)
+{
+    [McpServerTool(Name = "reply_email"), Description(
+        "Reply to an existing email in its native provider thread. Both accountId and emailId are required; obtain them from get_emails, search_emails, or get_email_details. Set replyAll only when every original participant should receive the response.")]
+    public async Task<string> ReplyEmail(
+        [Description("Account that owns the original email. Obtain from list_accounts and the email's accountId.")] string accountId,
+        [Description("Provider email ID of the message being answered.")] string emailId,
+        [Description("Reply body. Supply real HTML when bodyFormat is html; Markdown is not converted.")] string body,
+        [Description("Reply to all original participants instead of only the sender. Defaults to false.")] bool replyAll = false,
+        [Description("Reply body format: html (default) or text.")] string bodyFormat = "html")
+    {
+        if (string.IsNullOrWhiteSpace(accountId))
+            throw new McpException("accountId is required for reply_email.");
+        if (string.IsNullOrWhiteSpace(emailId))
+            throw new McpException("emailId is required for reply_email.");
+        if (string.IsNullOrWhiteSpace(body))
+            throw new McpException("body is required for reply_email.");
+        if (!bodyFormat.Equals("html", StringComparison.OrdinalIgnoreCase) &&
+            !bodyFormat.Equals("text", StringComparison.OrdinalIgnoreCase))
+            throw new McpException("bodyFormat must be either 'html' or 'text'.");
+
+        var account = await ToolGuard.RequireAccountAsync(
+            accountRegistry, accountId, Models.AccountPermission.EmailSend);
+
+        try
+        {
+            var provider = providerFactory.GetProvider(account.Provider);
+            var replyReference = await provider.ReplyToEmailAsync(
+                account.Id, emailId, body, replyAll, bodyFormat, CancellationToken.None);
+
+            return JsonSerializer.Serialize(new
+            {
+                success = true,
+                replyReference,
+                accountUsed = account.Id,
+                repliedToMessageId = emailId,
+                replyAll
+            }, new JsonSerializerOptions { WriteIndented = true });
+        }
+        catch (Exception ex) when (ex is not McpException)
+        {
+            logger.LogError(ex, "Error replying to email {EmailId} from account {AccountId}", emailId, accountId);
+            throw new McpException("Failed to reply to email.", ex);
+        }
+    }
+}
