+    public async Task<string> ReplyToEmailAsync(
+        string accountId,
+        string emailId,
+        string body,
+        bool replyAll = false,
+        string bodyFormat = "html",
+        CancellationToken cancellationToken = default)
+    {
+        var credential = await GetCredentialAsync(accountId, cancellationToken)
+            ?? throw new InvalidOperationException($"Cannot reply to email: No authentication credential for account {accountId}");
+        var service = CreateGmailService(credential);
+        var original = await service.Users.Messages.Get("me", emailId).ExecuteAsync(cancellationToken);
+        var headers = original.Payload?.Headers ?? [];
+        var profile = await service.Users.GetProfile("me").ExecuteAsync(cancellationToken);
+        var ownAddress = profile.EmailAddress ?? string.Empty;
+
+        var reply = new MimeMessage();
+        reply.From.Add(MailboxAddress.Parse(ownAddress));
+        var replyTo = GetHeader(headers, "Reply-To");
+        var from = GetHeader(headers, "From");
+        AddUniqueAddresses(reply.To, string.IsNullOrWhiteSpace(replyTo) ? from : replyTo, ownAddress);
+        if (replyAll)
+        {
+            AddUniqueAddresses(reply.To, GetHeader(headers, "To"), ownAddress);
+            AddUniqueAddresses(reply.Cc, GetHeader(headers, "Cc"), ownAddress, reply.To);
+        }
+
+        var subject = GetHeader(headers, "Subject");
+        reply.Subject = subject.StartsWith("Re:", StringComparison.OrdinalIgnoreCase) ? subject : $"Re: {subject}";
+        var originalMessageId = GetHeader(headers, "Message-ID");
+        if (!string.IsNullOrWhiteSpace(originalMessageId))
+        {
+            reply.InReplyTo = originalMessageId;
+            var references = GetHeader(headers, "References");
+            foreach (var reference in (references + " " + originalMessageId)
+                         .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
+                reply.References.Add(reference);
+        }
+        reply.Body = new TextPart(bodyFormat.Equals("text", StringComparison.OrdinalIgnoreCase)
+            ? MimeKit.Text.TextFormat.Plain
+            : MimeKit.Text.TextFormat.Html) { Text = body };
+
+        using var stream = new MemoryStream();
+        await reply.WriteToAsync(stream, cancellationToken);
+        var raw = Convert.ToBase64String(stream.ToArray()).Replace('+', '-').Replace('/', '_').TrimEnd('=');
+        var sent = await service.Users.Messages.Send(new Message { Raw = raw, ThreadId = original.ThreadId }, "me")
+            .ExecuteAsync(cancellationToken);
+        return sent.Id;
+    }
+
+    private static void AddUniqueAddresses(
+        InternetAddressList target,
+        string addresses,
+        string ownAddress,
+        InternetAddressList? alreadyIncluded = null)
+    {
+        if (string.IsNullOrWhiteSpace(addresses)) return;
+        var existing = target.Mailboxes.Concat(alreadyIncluded?.Mailboxes ?? [])
+            .Select(address => address.Address)
+            .ToHashSet(StringComparer.OrdinalIgnoreCase);
+        foreach (var mailbox in InternetAddressList.Parse(addresses).Mailboxes)
+        {
+            if (!mailbox.Address.Equals(ownAddress, StringComparison.OrdinalIgnoreCase) && existing.Add(mailbox.Address))
+                target.Add(mailbox);
+        }
+    }
