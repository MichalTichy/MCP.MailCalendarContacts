+    public async Task<string> ReplyToEmailAsync(
+        string accountId,
+        string emailId,
+        string body,
+        bool replyAll = false,
+        string bodyFormat = "html",
+        CancellationToken cancellationToken = default)
+    {
+        var (folderName, uidValidity, uid) = ParseEmailId(emailId);
+        var cfg = await ResolveConfigAsync(accountId);
+        var original = await WithImapAsync(cfg, async client =>
+        {
+            var folder = await OpenFolderAsync(client, folderName, FolderAccess.ReadOnly, cancellationToken);
+            EnsureUidValidity(folder, uidValidity, accountId, folderName);
+            return await folder.GetMessageAsync(new UniqueId(uid), cancellationToken);
+        }, cancellationToken) ?? throw new InvalidOperationException($"Email '{emailId}' was not found.");
+
+        var reply = new MimeMessage();
+        reply.From.Add(MailboxAddress.Parse(cfg.Username));
+        AddReplyRecipients(reply.To, original.ReplyTo.Count > 0 ? original.ReplyTo : original.From, cfg.Username);
+        if (replyAll)
+        {
+            AddReplyRecipients(reply.To, original.To, cfg.Username);
+            AddReplyRecipients(reply.Cc, original.Cc, cfg.Username, reply.To);
+        }
+        reply.Subject = original.Subject?.StartsWith("Re:", StringComparison.OrdinalIgnoreCase) == true
+            ? original.Subject
+            : $"Re: {original.Subject}";
+        if (!string.IsNullOrWhiteSpace(original.MessageId))
+        {
+            reply.InReplyTo = original.MessageId;
+            foreach (var reference in original.References) reply.References.Add(reference);
+            reply.References.Add(original.MessageId);
+        }
+        reply.Body = new TextPart(bodyFormat.Equals("text", StringComparison.OrdinalIgnoreCase)
+            ? TextFormat.Plain
+            : TextFormat.Html) { Text = body };
+
+        using (var smtp = await OpenSmtpAsync(cfg, cancellationToken))
+        {
+            await smtp.SendAsync(reply, cancellationToken);
+            await smtp.DisconnectAsync(true, cancellationToken);
+        }
+        try
+        {
+            await WithImapAsync(cfg, async imap =>
+            {
+                var sent = await imap.GetFolderAsync(cfg.SentFolder, cancellationToken);
+                await sent.OpenAsync(FolderAccess.ReadWrite, cancellationToken);
+                await sent.AppendAsync(reply, MessageFlags.Seen, DateTimeOffset.Now, cancellationToken);
+            }, cancellationToken);
+        }
+        catch (Exception ex)
+        {
+            _logger.LogWarning(ex, "Failed to append reply to {Folder} for {AccountId}", cfg.SentFolder, accountId);
+        }
+
+        return reply.MessageId ?? string.Empty;
+    }
+
+    private static void AddReplyRecipients(
+        InternetAddressList target,
+        InternetAddressList source,
+        string ownAddress,
+        InternetAddressList? alreadyIncluded = null)
+    {
+        var existing = target.Mailboxes.Concat(alreadyIncluded?.Mailboxes ?? [])
+            .Select(address => address.Address)
+            .ToHashSet(StringComparer.OrdinalIgnoreCase);
+        foreach (var mailbox in source.Mailboxes)
+        {
+            if (!mailbox.Address.Equals(ownAddress, StringComparison.OrdinalIgnoreCase) && existing.Add(mailbox.Address))
+                target.Add(mailbox);
+        }
+    }
