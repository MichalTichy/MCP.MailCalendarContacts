     }
 
+    /// <summary>
+    /// Converts an offset-aware MCP date-time into the wall time expected by calendar
+    /// providers. JSON binds an ISO offset to DateTimeKind.Local on the server, so
+    /// forwarding its clock fields with a separate timeZone can shift the event.
+    /// Offset-free input is already a wall time in the requested zone.
+    /// </summary>
+    public static DateTime ToCalendarWallTime(DateTime value, string? timeZone)
+    {
+        if (value.Kind == DateTimeKind.Unspecified)
+            return value;
+
+        var zone = TryGetTimeZone(timeZone ?? "UTC")
+            ?? throw new ArgumentException($"Invalid IANA timezone: '{timeZone}'.", nameof(timeZone));
+        var localTime = TimeZoneInfo.ConvertTime(value, zone);
+        return DateTime.SpecifyKind(localTime, DateTimeKind.Unspecified);
+    }
+
