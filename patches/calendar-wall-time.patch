 using CalendarMcp.Core.Utilities;
 
 namespace CalendarMcp.Tests.Utilities;
@@ -92,4 +93,37 @@ public class TimeZoneHelperTests
         var tz = TimeZoneHelper.TryGetTimeZone("'America/Chicago`");
         Assert.IsNull(tz);
     }
+
+    [TestMethod]
+    public void ToCalendarWallTime_OffsetAwareJson_PreservesIntendedPragueTime()
+    {
+        var input = JsonSerializer.Deserialize<DateTime>("\"2026-09-16T16:49:00+02:00\"");
+
+        var result = TimeZoneHelper.ToCalendarWallTime(input, "Europe/Prague");
+
+        Assert.AreEqual(new DateTime(2026, 9, 16, 16, 49, 0), result);
+        Assert.AreEqual(DateTimeKind.Unspecified, result.Kind);
+    }
+
+    [TestMethod]
+    public void ToCalendarWallTime_OffsetFreeJson_RemainsLocalWallTime()
+    {
+        var input = JsonSerializer.Deserialize<DateTime>("\"2026-09-16T16:49:00\"");
+
+        var result = TimeZoneHelper.ToCalendarWallTime(input, "Europe/Prague");
+
+        Assert.AreEqual(new DateTime(2026, 9, 16, 16, 49, 0), result);
+        Assert.AreEqual(DateTimeKind.Unspecified, result.Kind);
+    }
+
+    [TestMethod]
+    public void ToCalendarWallTime_UtcJson_ConvertsToRequestedZone()
+    {
+        var input = JsonSerializer.Deserialize<DateTime>("\"2026-09-16T14:49:00Z\"");
+
+        var result = TimeZoneHelper.ToCalendarWallTime(input, "Europe/Prague");
+
+        Assert.AreEqual(new DateTime(2026, 9, 16, 16, 49, 0), result);
+        Assert.AreEqual(DateTimeKind.Unspecified, result.Kind);
+    }
 }
