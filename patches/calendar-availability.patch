diff --git a/src/CalendarMcp.Tests/Tools/CalendarAvailabilityOutputTests.cs b/src/CalendarMcp.Tests/Tools/CalendarAvailabilityOutputTests.cs
new file mode 100644
index 0000000..bf433f8
--- /dev/null
+++ b/src/CalendarMcp.Tests/Tools/CalendarAvailabilityOutputTests.cs
@@ -0,0 +1,73 @@
+using System.Text.Json;
+using CalendarMcp.Core.Models;
+using CalendarMcp.Core.Services;
+using CalendarMcp.Core.Tools;
+using CalendarMcp.Tests.Helpers;
+using Microsoft.Extensions.Logging.Abstractions;
+using Rocks;
+
+namespace CalendarMcp.Tests.Tools;
+
+[TestClass]
+public sealed class CalendarAvailabilityOutputTests
+{
+    [TestMethod]
+    [DataRow("free", false)]
+    [DataRow("busy", false)]
+    [DataRow("tentative", false)]
+    [DataRow("outOfOffice", false)]
+    [DataRow("workingElsewhere", false)]
+    [DataRow("unknown", false)]
+    [DataRow("free", true)]
+    public async Task AllDayAvailabilityIsReturnedConsistentlyByListAndDetail(string showAs, bool cancelled)
+    {
+        var account = TestData.CreateAccount();
+        var evt = new CalendarEvent
+        {
+            Id = "workout", AccountId = account.Id, CalendarId = "primary", Subject = "Workout",
+            Start = new DateTimeOffset(2026, 11, 5, 0, 0, 0, TimeSpan.Zero),
+            End = new DateTimeOffset(2026, 11, 6, 0, 0, 0, TimeSpan.Zero),
+            IsAllDay = true, ShowAs = showAs, IsCancelled = cancelled, ResponseStatus = "declined"
+        };
+        var registry = new IAccountRegistryCreateExpectations();
+        registry.Setups.GetAccountAsync(account.Id)
+            .ReturnValue(Task.FromResult<AccountInfo?>(account)).ExpectedCallCount(2);
+        var provider = new IProviderServiceCreateExpectations();
+        provider.Setups.GetCalendarEventsAsync(account.Id, "primary", Arg.Any<DateTime?>(),
+                Arg.Any<DateTime?>(), Arg.Any<int>(), Arg.Any<CancellationToken>())
+            .ReturnValue(Task.FromResult<IEnumerable<CalendarEvent>>([evt]));
+        provider.Setups.GetCalendarEventDetailsAsync(account.Id, "primary", evt.Id, Arg.Any<CancellationToken>())
+            .ReturnValue(Task.FromResult<CalendarEvent?>(evt));
+        var factory = new IProviderServiceFactoryCreateExpectations();
+        factory.Setups.GetProvider(account.Provider).ReturnValue(provider.Instance()).ExpectedCallCount(2);
+        var registryInstance = registry.Instance();
+        var factoryInstance = factory.Instance();
+        var list = new GetCalendarEventsTool(registryInstance, factoryInstance,
+            NullLogger<GetCalendarEventsTool>.Instance);
+        var detail = new GetCalendarEventDetailsTool(registryInstance, factoryInstance,
+            NullLogger<GetCalendarEventDetailsTool>.Instance);
+
+        using var listJson = JsonDocument.Parse(await list.GetCalendarEvents("Europe/Prague",
+            new DateTime(2026, 11, 5), new DateTime(2026, 11, 6), account.Id, "primary"));
+        using var detailJson = JsonDocument.Parse(await detail.GetCalendarEventDetails(
+            "Europe/Prague", account.Id, "primary", evt.Id));
+
+        foreach (var item in new[] { listJson.RootElement.GetProperty("events")[0], detailJson.RootElement })
+        {
+            Assert.AreEqual(showAs, item.GetProperty("showAs").GetString());
+            Assert.AreEqual(cancelled, item.GetProperty("isCancelled").GetBoolean());
+            Assert.AreEqual("declined", item.GetProperty("responseStatus").GetString());
+            Assert.IsTrue(item.GetProperty("isAllDay").GetBoolean());
+        }
+        registry.Verify();
+        provider.Verify();
+        factory.Verify();
+    }
+
+    [TestMethod]
+    public void MissingAvailabilityIsUnknownRatherThanBusy()
+    {
+        var evt = TestData.CreateEvent();
+        Assert.AreEqual("unknown", evt.ShowAs);
+    }
+}
