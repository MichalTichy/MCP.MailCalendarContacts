diff --git a/src/CalendarMcp.Tests/Providers/GraphCalendarAvailabilityTests.cs b/src/CalendarMcp.Tests/Providers/GraphCalendarAvailabilityTests.cs
new file mode 100644
index 0000000..273560d
--- /dev/null
+++ b/src/CalendarMcp.Tests/Providers/GraphCalendarAvailabilityTests.cs
@@ -0,0 +1,103 @@
+using System.Net;
+using System.Text;
+using System.Text.Json;
+using System.Web;
+using CalendarMcp.Core.Models;
+using CalendarMcp.Core.Providers;
+using CalendarMcp.Core.Services;
+using CalendarMcp.Tests.Helpers;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.Graph;
+using Microsoft.Kiota.Abstractions.Authentication;
+using Rocks;
+
+namespace CalendarMcp.Tests.Providers;
+
+[TestClass]
+public sealed class GraphCalendarAvailabilityTests
+{
+    [TestMethod]
+    [DataRow("microsoft365", "primary")]
+    [DataRow("microsoft365", "named-calendar")]
+    [DataRow("outlook.com", "primary")]
+    [DataRow("outlook.com", "named-calendar")]
+    public async Task ListAndDetailPreserveAvailabilityFromGraph(string providerName, string calendarId)
+    {
+        (string? GraphValue, string Expected)[] cases =
+        [
+            ("free", "free"), ("busy", "busy"), ("tentative", "tentative"),
+            ("oof", "outOfOffice"), ("workingElsewhere", "workingElsewhere"),
+            ("unknown", "unknown"), (null, "unknown")
+        ];
+
+        foreach (var (graphValue, expected) in cases)
+        {
+            var account = TestData.CreateAccount(provider: providerName,
+                providerConfig: new() { ["tenantId"] = "test-tenant", ["clientId"] = "test-client" });
+            var registry = new IAccountRegistryCreateExpectations();
+            registry.Setups.GetAccountAsync(account.Id)
+                .ReturnValue(Task.FromResult<AccountInfo?>(account)).ExpectedCallCount(2);
+            var auth = new IM365AuthenticationServiceCreateExpectations();
+            auth.Setups.GetTokenSilentlyAsync("test-tenant", "test-client", Arg.Any<string[]>(),
+                    account.Id, Arg.Any<CancellationToken>())
+                .ReturnValue(Task.FromResult<string?>("unit-test-token")).ExpectedCallCount(2);
+            using var handler = new CalendarHandler(graphValue);
+            using var http = new HttpClient(handler);
+            using var graph = new GraphServiceClient(http, new AnonymousAuthenticationProvider());
+            IProviderService provider = providerName == "microsoft365"
+                ? new M365ProviderService(NullLogger<M365ProviderService>.Instance,
+                    auth.Instance(), registry.Instance(), _ => graph)
+                : new OutlookComProviderService(NullLogger<OutlookComProviderService>.Instance,
+                    auth.Instance(), registry.Instance(), _ => graph);
+
+            var events = (await provider.GetCalendarEventsAsync(account.Id, calendarId,
+                new DateTime(2026, 11, 5), new DateTime(2026, 11, 6))).ToArray();
+            Assert.AreEqual(1, events.Length, $"Calendar list lost the {graphValue ?? "missing"} event");
+            var detail = await provider.GetCalendarEventDetailsAsync(account.Id, calendarId, "workout");
+            Assert.IsNotNull(detail);
+
+            foreach (var item in new[] { events[0], detail })
+            {
+                Assert.AreEqual(expected, item.ShowAs, "Provider availability must survive mapping");
+                Assert.IsTrue(item.IsAllDay);
+                Assert.IsTrue(item.IsCancelled, "Cancellation must survive list and detail reads");
+                Assert.AreEqual("declined", item.ResponseStatus);
+            }
+            Assert.AreEqual(2, handler.Requests);
+            registry.Verify();
+            auth.Verify();
+        }
+    }
+
+    private sealed class CalendarHandler(string? showAs) : HttpMessageHandler
+    {
+        public int Requests { get; private set; }
+
+        protected override Task<HttpResponseMessage> SendAsync(
+            HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            Requests++;
+            var uri = request.RequestUri!;
+            var fields = HttpUtility.ParseQueryString(uri.Query)["$select"]?.Split(',') ?? [];
+            foreach (var required in new[] { "showAs", "isCancelled", "responseStatus" })
+                Assert.IsTrue(fields.Contains(required), $"Graph request must select {required}");
+
+            var evt = new Dictionary<string, object?>
+            {
+                ["id"] = "workout", ["subject"] = "Informational workout",
+                ["start"] = new { dateTime = "2026-11-05T00:00:00", timeZone = "UTC" },
+                ["end"] = new { dateTime = "2026-11-06T00:00:00", timeZone = "UTC" },
+                ["isAllDay"] = true, ["isCancelled"] = true,
+                ["responseStatus"] = new { response = "declined" }
+            };
+            if (showAs != null)
+                evt["showAs"] = showAs;
+            object payload = uri.AbsolutePath.EndsWith("calendarView", StringComparison.Ordinal)
+                ? new { value = new[] { evt } } : evt;
+            return Task.FromResult(new HttpResponseMessage(HttpStatusCode.OK)
+            {
+                Content = new StringContent(JsonSerializer.Serialize(payload), Encoding.UTF8, "application/json")
+            });
+        }
+    }
+}
