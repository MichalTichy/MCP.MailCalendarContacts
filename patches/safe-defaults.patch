@@ -0,0 +1,2 @@
+using CalendarMcp.Core.Models;
+
@@ -9 +11 @@ public static class GoogleScopes
-    /// Full access scopes for Gmail and Calendar (used by OAuth flows and provider services).
+    /// Full access scopes retained for CLI compatibility.
@@ -29,0 +32,36 @@ public static class GoogleScopes
+
+    /// <summary>Returns only the scopes required by the account's explicit grants.</summary>
+    public static string[] ForPermissions(AccountPermissions permissions)
+    {
+        var scopes = new List<string>();
+        if (permissions.EmailRead)
+        {
+            scopes.Add("https://www.googleapis.com/auth/gmail.modify");
+        }
+
+        if (permissions.EmailSend)
+        {
+            scopes.Add("https://www.googleapis.com/auth/gmail.send");
+        }
+
+        if (permissions.CalendarRead || permissions.CalendarWrite)
+        {
+            scopes.Add("https://www.googleapis.com/auth/calendar.readonly");
+        }
+
+        if (permissions.CalendarWrite)
+        {
+            scopes.Add("https://www.googleapis.com/auth/calendar.events");
+        }
+
+        if (permissions.ContactsWrite)
+        {
+            scopes.Add("https://www.googleapis.com/auth/contacts");
+        }
+        else if (permissions.ContactsRead)
+        {
+            scopes.Add("https://www.googleapis.com/auth/contacts.readonly");
+        }
+
+        return [.. scopes];
+    }
@@ -38 +76 @@ public static class M365Scopes
-    /// Default scopes for Microsoft Graph API access (mail read/write + calendar).
+    /// Full access scopes retained for CLI compatibility.
@@ -68,0 +107,40 @@ public static class M365Scopes
+
+    /// <summary>Returns only the scopes required by the account's explicit grants.</summary>
+    public static string[] ForPermissions(AccountPermissions permissions, bool includeFilesRead = false)
+    {
+        var scopes = new List<string>();
+        if (permissions.EmailRead)
+        {
+            scopes.Add("Mail.ReadWrite");
+        }
+
+        if (permissions.EmailSend)
+        {
+            scopes.Add("Mail.Send");
+        }
+
+        if (permissions.CalendarWrite)
+        {
+            scopes.Add("Calendars.ReadWrite");
+        }
+        else if (permissions.CalendarRead)
+        {
+            scopes.Add("Calendars.Read");
+        }
+
+        if (permissions.ContactsWrite)
+        {
+            scopes.Add("Contacts.ReadWrite");
+        }
+        else if (permissions.ContactsRead)
+        {
+            scopes.Add("Contacts.Read");
+        }
+
+        if (includeFilesRead)
+        {
+            scopes.Add("Files.Read");
+        }
+
+        return [.. scopes];
+    }
@@ -77 +155 @@ public static class OutlookComScopes
-    /// Default scopes for Outlook.com personal accounts.
+    /// Full access scopes retained for CLI compatibility.
@@ -99,0 +178,4 @@ public static class OutlookComScopes
+
