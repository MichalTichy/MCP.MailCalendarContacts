diff --git a/src/CalendarMcp.Core/Services/GatewayAgentFileDownloader.cs b/src/CalendarMcp.Core/Services/GatewayAgentFileDownloader.cs
new file mode 100644
index 0000000..bfbbac1
--- /dev/null
+++ b/src/CalendarMcp.Core/Services/GatewayAgentFileDownloader.cs
@@ -0,0 +1,78 @@
+using System.Security.Cryptography;
+using CalendarMcp.Core.Models;
+using Microsoft.Extensions.Configuration;
+using ModelContextProtocol;
+
+namespace CalendarMcp.Core.Services;
+
+/// <summary>Downloads only short-lived files exposed by the configured Codex Gateway origin.</summary>
+public sealed class GatewayAgentFileDownloader(
+    IHttpClientFactory httpClientFactory,
+    IConfiguration configuration)
+{
+    private const long MaxAttachmentBytes = 25L * 1024 * 1024;
+    private const string RoutePrefix = "/_internal/mcp/artifacts/";
+
+    public async Task<OutboundEmailAttachment> DownloadAsync(OutboundEmailAttachment attachment)
+    {
+        var originText = configuration["CalendarMcp:AgentFileOrigin"];
+        if (!Uri.TryCreate(originText, UriKind.Absolute, out var origin) ||
+            origin.AbsolutePath != "/" ||
+            origin.Query.Length != 0 ||
+            origin.Fragment.Length != 0 ||
+            origin.UserInfo.Length != 0 ||
+            origin.Scheme is not ("http" or "https"))
+            throw new McpException("CalendarMcp:AgentFileOrigin must be configured before agentFileUrl can be used.");
+
+        if (!Uri.TryCreate(attachment.AgentFileUrl, UriKind.Absolute, out var url) ||
+            !string.Equals(url.GetLeftPart(UriPartial.Authority),
+                origin.GetLeftPart(UriPartial.Authority), StringComparison.OrdinalIgnoreCase) ||
+            url.UserInfo.Length != 0 ||
+            url.Query.Length != 0 ||
+            url.Fragment.Length != 0 ||
+            !url.AbsolutePath.StartsWith(RoutePrefix, StringComparison.Ordinal) ||
+            url.AbsolutePath[RoutePrefix.Length..] is not { Length: 43 } token ||
+            !token.All(character => char.IsAsciiLetterOrDigit(character) || character is '-' or '_'))
+            throw new McpException("agentFileUrl must be a run-scoped artifact URL on the configured Codex Gateway origin.");
+
+        using var response = await httpClientFactory.CreateClient("GatewayAgentFiles")
+            .GetAsync(url, HttpCompletionOption.ResponseHeadersRead);
+        if (!response.IsSuccessStatusCode)
+            throw new McpException($"The agent file could not be downloaded (HTTP {(int)response.StatusCode}).");
+        if (response.Content.Headers.ContentLength is > MaxAttachmentBytes)
+            throw new McpException("The agent file exceeds the 25 MB attachment limit.");
+
+        await using var source = await response.Content.ReadAsStreamAsync();
+        await using var destination = new MemoryStream();
+        var buffer = new byte[64 * 1024];
+        int read;
+        while ((read = await source.ReadAsync(buffer)) > 0)
+        {
+            if (destination.Length + read > MaxAttachmentBytes)
+                throw new McpException("The agent file exceeds the 25 MB attachment limit.");
+            await destination.WriteAsync(buffer.AsMemory(0, read));
+        }
+
+        var bytes = destination.ToArray();
+        if (!response.Headers.TryGetValues("X-Content-SHA256", out var values) ||
+            !string.Equals(values.SingleOrDefault(),
+                Convert.ToHexStringLower(SHA256.HashData(bytes)), StringComparison.OrdinalIgnoreCase))
+            throw new McpException("The downloaded agent file failed its SHA-256 integrity check.");
+
+        var fileName = response.Content.Headers.ContentDisposition?.FileNameStar ??
+            response.Content.Headers.ContentDisposition?.FileName?.Trim('"');
+        var name = string.IsNullOrWhiteSpace(attachment.Name)
+            ? Path.GetFileName(fileName)
+            : attachment.Name;
+        if (string.IsNullOrWhiteSpace(name))
+            throw new McpException("The agent file has no attachment name.");
+
+        return new OutboundEmailAttachment
+        {
+            Name = name,
+            ContentType = attachment.ContentType ?? response.Content.Headers.ContentType?.MediaType ??
+                "application/octet-stream",
+            Base64Content = Convert.ToBase64String(bytes)
+        };
+    }
+}
