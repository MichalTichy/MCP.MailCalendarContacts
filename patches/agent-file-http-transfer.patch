diff --git a/src/CalendarMcp.Tests/Tools/GatewayAgentFileDownloaderTests.cs b/src/CalendarMcp.Tests/Tools/GatewayAgentFileDownloaderTests.cs
new file mode 100644
index 0000000..2f13d8c
--- /dev/null
+++ b/src/CalendarMcp.Tests/Tools/GatewayAgentFileDownloaderTests.cs
@@ -0,0 +1,109 @@
+using System.Net;
+using System.Net.Http.Headers;
+using System.Security.Cryptography;
+using CalendarMcp.Core.Models;
+using CalendarMcp.Core.Services;
+using Microsoft.Extensions.Configuration;
+using ModelContextProtocol;
+
+namespace CalendarMcp.Tests.Tools;
+
+[TestClass]
+public sealed class GatewayAgentFileDownloaderTests
+{
+    private const string ArtifactUrl =
+        "http://gateway:8080/_internal/mcp/artifacts/abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNO_0";
+
+    [TestMethod]
+    public async Task Downloads_verified_file_with_name_and_type_from_gateway()
+    {
+        var bytes = "PDF bytes"u8.ToArray();
+        var handler = new StubHandler(() =>
+        {
+            var response = new HttpResponseMessage(HttpStatusCode.OK)
+            {
+                Content = new ByteArrayContent(bytes)
+            };
+            response.Content.Headers.ContentType = new MediaTypeHeaderValue("application/pdf");
+            response.Content.Headers.ContentDisposition = new ContentDispositionHeaderValue("attachment")
+            {
+                FileNameStar = "invoice.pdf"
+            };
+            response.Headers.Add("X-Content-SHA256", Convert.ToHexStringLower(SHA256.HashData(bytes)));
+            return response;
+        });
+        var downloader = CreateDownloader(handler);
+
+        var result = await downloader.DownloadAsync(new OutboundEmailAttachment
+        {
+            AgentFileUrl = ArtifactUrl
+        });
+
+        Assert.AreEqual("invoice.pdf", result.Name);
+        Assert.AreEqual("application/pdf", result.ContentType);
+        CollectionAssert.AreEqual(bytes, Convert.FromBase64String(result.Base64Content!));
+        Assert.AreEqual(1, handler.CallCount);
+    }
+
+    [TestMethod]
+    public async Task Rejects_untrusted_origin_before_http_request()
+    {
+        var handler = new StubHandler(() => new HttpResponseMessage(HttpStatusCode.OK));
+        var downloader = CreateDownloader(handler);
+
+        await Assert.ThrowsExceptionAsync<McpException>(() => downloader.DownloadAsync(
+            new OutboundEmailAttachment
+            {
+                AgentFileUrl = ArtifactUrl.Replace("gateway:8080", "attacker.test")
+            }));
+
+        Assert.AreEqual(0, handler.CallCount);
+    }
+
+    [TestMethod]
+    public async Task Rejects_corrupt_file()
+    {
+        var handler = new StubHandler(() =>
+        {
+            var response = new HttpResponseMessage(HttpStatusCode.OK)
+            {
+                Content = new ByteArrayContent("tampered"u8.ToArray())
+            };
+            response.Headers.Add("X-Content-SHA256", new string('0', 64));
+            return response;
+        });
+        var downloader = CreateDownloader(handler);
+
+        await Assert.ThrowsExceptionAsync<McpException>(() => downloader.DownloadAsync(
+            new OutboundEmailAttachment { AgentFileUrl = ArtifactUrl }));
+    }
+
+    private static GatewayAgentFileDownloader CreateDownloader(HttpMessageHandler handler)
+    {
+        var client = new HttpClient(handler);
+        var configuration = new ConfigurationBuilder().AddInMemoryCollection(
+            new Dictionary<string, string?>
+            {
+                ["CalendarMcp:AgentFileOrigin"] = "http://gateway:8080"
+            }).Build();
+        return new GatewayAgentFileDownloader(new StubClientFactory(client), configuration);
+    }
+
+    private sealed class StubClientFactory(HttpClient client) : IHttpClientFactory
+    {
+        public HttpClient CreateClient(string name) => client;
+    }
+
+    private sealed class StubHandler(Func<HttpResponseMessage> responseFactory) : HttpMessageHandler
+    {
+        public int CallCount { get; private set; }
+
+        protected override Task<HttpResponseMessage> SendAsync(
+            HttpRequestMessage request,
+            CancellationToken cancellationToken)
+        {
+            CallCount++;
+            return Task.FromResult(responseFactory());
+        }
+    }
+}
