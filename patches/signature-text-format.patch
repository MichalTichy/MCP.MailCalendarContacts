+    [TestMethod]
+    public void Compose_Text_StripsEmbeddedImageMarkupFromConfiguredTextSignature()
+    {
+        var account = TestData.CreateAccount(emailSignature: new EmailSignature
+        {
+            Enabled = true,
+            Text = "Best regards\nMichal<img src=\"cid:logo\" alt=\"\">",
+            Images =
+            [
+                new EmailSignatureImage
+                {
+                    ContentId = "logo",
+                    Name = "logo.png",
+                    ContentType = "image/png",
+                    Base64Content = Convert.ToBase64String([1, 2, 3])
+                }
+            ]
+        });
+
+        var result = _service.Compose(account, "Hello", "text");
+
+        Assert.AreEqual("Hello\r\n\r\n-- \r\nBest regards\nMichal", result.Body);
+        Assert.IsNull(result.Attachments);
+        Assert.IsFalse(result.Body.Contains("cid:", StringComparison.OrdinalIgnoreCase));
+    }
