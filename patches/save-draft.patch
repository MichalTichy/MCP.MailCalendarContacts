diff --git a/src/CalendarMcp.Core/Tools/SaveDraftTool.cs b/src/CalendarMcp.Core/Tools/SaveDraftTool.cs
new file mode 100644
index 0000000..d6a07fc
--- /dev/null
+++ b/src/CalendarMcp.Core/Tools/SaveDraftTool.cs
@@ -0,0 +1,74 @@
+using System.ComponentModel;
+using System.Text.Json;
+using CalendarMcp.Core.Services;
+using Microsoft.Extensions.Logging;
+using ModelContextProtocol;
+using ModelContextProtocol.Server;
+
+namespace CalendarMcp.Core.Tools;
+
+[McpServerToolType]
+public sealed class SaveDraftTool(
+    IAccountRegistry accountRegistry,
+    IProviderServiceFactory providerFactory,
+    ILogger<SaveDraftTool> logger)
+{
+    [McpServerTool(Name = "save_draft"), Description(
+        "Save an email draft without sending it. For a new message, provide accountId, to, subject, and body. To draft a native-thread reply, provide accountId, replyToEmailId, and body; recipients, subject, and thread are derived from the original email. Set replyAll only when all original participants should be included.")]
+    public async Task<string> SaveDraft(
+        [Description("Account in which to save the draft. Obtain from list_accounts.")] string accountId,
+        [Description("Draft body. Supply real HTML when bodyFormat is html; Markdown is not converted.")] string body,
+        [Description("Recipients for a new message. Required unless replyToEmailId is provided.")] List<string>? to = null,
+        [Description("Subject for a new message. Required unless replyToEmailId is provided.")] string? subject = null,
+        [Description("Draft body format: html (default) or text.")] string bodyFormat = "html",
+        [Description("Optional CC recipients for a new message. Reply drafts derive CC recipients from the original message when replyAll is true.")] List<string>? cc = null,
+        [Description("Provider email ID of the message being answered. Obtain from get_emails, search_emails, or get_email_details. Omit when composing a new message.")] string? replyToEmailId = null,
+        [Description("For a reply draft, include all original participants instead of only the sender. Ignored for a new message.")] bool replyAll = false)
+    {
+        if (string.IsNullOrWhiteSpace(accountId))
+            throw new McpException("accountId is required for save_draft.");
+        if (string.IsNullOrWhiteSpace(body))
+            throw new McpException("body is required for save_draft.");
+        if (!bodyFormat.Equals("html", StringComparison.OrdinalIgnoreCase) &&
+            !bodyFormat.Equals("text", StringComparison.OrdinalIgnoreCase))
+            throw new McpException("bodyFormat must be either 'html' or 'text'.");
+
+        var isReply = !string.IsNullOrWhiteSpace(replyToEmailId);
+        if (!isReply && (to is null || to.Count == 0))
+            throw new McpException("At least one recipient is required unless replyToEmailId is provided.");
+        if (!isReply && string.IsNullOrWhiteSpace(subject))
+            throw new McpException("subject is required unless replyToEmailId is provided.");
+
+        var account = await ToolGuard.RequireAccountAsync(
+            accountRegistry, accountId, Models.AccountPermission.EmailSend);
+
+        try
+        {
+            var provider = providerFactory.GetProvider(account.Provider);
+            var draftReference = await provider.SaveDraftAsync(
+                account.Id,
+                isReply ? null : string.Join(", ", to!),
+                isReply ? null : subject,
+                body,
+                bodyFormat,
+                isReply ? null : cc,
+                replyToEmailId,
+                replyAll,
+                CancellationToken.None);
+
+            return JsonSerializer.Serialize(new
+            {
+                success = true,
+                draftReference,
+                accountUsed = account.Id,
+                replyToEmailId,
+                replyAll = isReply && replyAll
+            }, new JsonSerializerOptions { WriteIndented = true });
+        }
+        catch (Exception ex) when (ex is not McpException)
+        {
+            logger.LogError(ex, "Error saving email draft in account {AccountId}", accountId);
+            throw new McpException("Failed to save email draft.", ex);
+        }
+    }
+}
