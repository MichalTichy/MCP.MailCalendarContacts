+    public async Task<string> SaveDraftAsync(
+        string accountId,
+        string? to,
+        string? subject,
+        string body,
+        string bodyFormat = "html",
+        List<string>? cc = null,
+        string? replyToEmailId = null,
+        bool replyAll = false,
+        CancellationToken cancellationToken = default)
+    {
+        var cfg = await ResolveConfigAsync(accountId);
+        var draft = new MimeMessage();
+        draft.From.Add(MailboxAddress.Parse(cfg.Username));
+
+        if (!string.IsNullOrWhiteSpace(replyToEmailId))
+        {
+            var (folderName, uidValidity, uid) = ParseEmailId(replyToEmailId);
+            var original = await WithImapAsync(cfg, async client =>
+            {
+                var folder = await OpenFolderAsync(client, folderName, FolderAccess.ReadOnly, cancellationToken);
+                EnsureUidValidity(folder, uidValidity, accountId, folderName);
+                return await folder.GetMessageAsync(new UniqueId(uid), cancellationToken);
+            }, cancellationToken) ?? throw new InvalidOperationException($"Email '{replyToEmailId}' was not found.");
+
+            AddReplyRecipients(draft.To, original.ReplyTo.Count > 0 ? original.ReplyTo : original.From, cfg.Username);
+            if (replyAll)
+            {
+                AddReplyRecipients(draft.To, original.To, cfg.Username);
+                AddReplyRecipients(draft.Cc, original.Cc, cfg.Username, draft.To);
+            }
+            draft.Subject = original.Subject?.StartsWith("Re:", StringComparison.OrdinalIgnoreCase) == true
+                ? original.Subject
+                : $"Re: {original.Subject}";
+            if (!string.IsNullOrWhiteSpace(original.MessageId))
+            {
+                draft.InReplyTo = original.MessageId;
+                foreach (var reference in original.References) draft.References.Add(reference);
+                draft.References.Add(original.MessageId);
+            }
+        }
+        else
+        {
+            foreach (var address in SplitAddresses(to ?? string.Empty))
+                draft.To.Add(MailboxAddress.Parse(address));
+            if (cc is { Count: > 0 })
+                foreach (var address in cc)
+                    draft.Cc.Add(MailboxAddress.Parse(address));
+            draft.Subject = subject ?? string.Empty;
+        }
+
+        draft.Body = new TextPart(bodyFormat.Equals("text", StringComparison.OrdinalIgnoreCase)
+            ? TextFormat.Plain
+            : TextFormat.Html) { Text = body };
+        await WithImapAsync(cfg, async client =>
+        {
+            var drafts = client.GetFolder(SpecialFolder.Drafts)
+                ?? throw new InvalidOperationException($"Account '{accountId}' does not expose an IMAP Drafts folder.");
+            await drafts.OpenAsync(FolderAccess.ReadWrite, cancellationToken);
+            await drafts.AppendAsync(draft, MessageFlags.Draft, DateTimeOffset.Now, cancellationToken);
+        }, cancellationToken);
+        return draft.MessageId ?? string.Empty;
+    }
