+    public async Task<string> SaveDraftAsync(
+        string accountId,
+        string? to,
+        string? subject,
+        string body,
+        string bodyFormat = "html",
+        List<string>? cc = null,
+        string? replyToEmailId = null,
+        bool replyAll = false,
+        CancellationToken cancellationToken = default)
+    {
+        var credential = await GetCredentialAsync(accountId, cancellationToken)
+            ?? throw new InvalidOperationException($"Cannot save email draft: No authentication credential for account {accountId}");
+        var service = CreateGmailService(credential);
+        var draftMessage = new MimeMessage();
+        string? threadId = null;
+
+        if (!string.IsNullOrWhiteSpace(replyToEmailId))
+        {
+            var original = await service.Users.Messages.Get("me", replyToEmailId).ExecuteAsync(cancellationToken);
+            var headers = original.Payload?.Headers ?? [];
+            var profile = await service.Users.GetProfile("me").ExecuteAsync(cancellationToken);
+            var ownAddress = profile.EmailAddress ?? string.Empty;
+            draftMessage.From.Add(MailboxAddress.Parse(ownAddress));
+            var replyTo = GetHeader(headers, "Reply-To");
+            var from = GetHeader(headers, "From");
+            AddUniqueAddresses(draftMessage.To, string.IsNullOrWhiteSpace(replyTo) ? from : replyTo, ownAddress);
+            if (replyAll)
+            {
+                AddUniqueAddresses(draftMessage.To, GetHeader(headers, "To"), ownAddress);
+                AddUniqueAddresses(draftMessage.Cc, GetHeader(headers, "Cc"), ownAddress, draftMessage.To);
+            }
+
+            var originalSubject = GetHeader(headers, "Subject");
+            draftMessage.Subject = originalSubject.StartsWith("Re:", StringComparison.OrdinalIgnoreCase)
+                ? originalSubject
+                : $"Re: {originalSubject}";
+            var originalMessageId = GetHeader(headers, "Message-ID");
+            if (!string.IsNullOrWhiteSpace(originalMessageId))
+            {
+                draftMessage.InReplyTo = originalMessageId;
+                var references = GetHeader(headers, "References");
+                foreach (var reference in (references + " " + originalMessageId)
+                             .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
+                    draftMessage.References.Add(reference);
+            }
+            threadId = original.ThreadId;
+        }
+        else
+        {
+            foreach (var address in (to ?? string.Empty).Split(',', ';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
+                draftMessage.To.Add(MailboxAddress.Parse(address));
+            if (cc is { Count: > 0 })
+                foreach (var address in cc)
+                    draftMessage.Cc.Add(MailboxAddress.Parse(address));
+            draftMessage.Subject = subject ?? string.Empty;
+        }
+
+        draftMessage.Body = new TextPart(bodyFormat.Equals("text", StringComparison.OrdinalIgnoreCase)
+            ? MimeKit.Text.TextFormat.Plain
+            : MimeKit.Text.TextFormat.Html) { Text = body };
+        using var stream = new MemoryStream();
+        await draftMessage.WriteToAsync(stream, cancellationToken);
+        var raw = Convert.ToBase64String(stream.ToArray()).Replace('+', '-').Replace('/', '_').TrimEnd('=');
+        var saved = await service.Users.Drafts.Create(
+            new Draft { Message = new Message { Raw = raw, ThreadId = threadId } },
+            "me").ExecuteAsync(cancellationToken);
+        return saved.Id;
+    }
