+using System.Text.Json;
+using CalendarMcp.Core.Models;
+using CalendarMcp.Core.Services;
+using CalendarMcp.Core.Tools;
+using CalendarMcp.Tests.Helpers;
+using Microsoft.Extensions.Logging.Abstractions;
+using ModelContextProtocol;
+using Rocks;
+
+namespace CalendarMcp.Tests.Tools;
+
+[TestClass]
+public class SaveDraftToolTests
+{
+    [TestMethod]
+    public async Task SaveDraft_NewMessage_PassesExplicitContentToProvider()
+    {
+        var account = TestData.CreateAccount(id: "sender", provider: "google");
+        var registry = new IAccountRegistryCreateExpectations();
+        registry.Setups.GetAccountAsync("sender").ReturnValue(Task.FromResult<AccountInfo?>(account));
+        var provider = new IProviderServiceCreateExpectations();
+        provider.Setups.SaveDraftAsync(
+                "sender", "to@example.com", "Subject", "Body", "text",
+                Arg.Any<List<string>?>(), Arg.Any<string?>(), false, Arg.Any<CancellationToken>())
+            .ReturnValue(Task.FromResult("draft-1"));
+        var factory = new IProviderServiceFactoryCreateExpectations();
+        factory.Setups.GetProvider("google").ReturnValue(provider.Instance());
+        var tool = new SaveDraftTool(registry.Instance(), factory.Instance(), NullLogger<SaveDraftTool>.Instance);
+
+        var json = await tool.SaveDraft(
+            "sender", "Body", ["to@example.com"], "Subject", "text");
+        using var document = JsonDocument.Parse(json);
+
+        Assert.AreEqual("draft-1", document.RootElement.GetProperty("draftReference").GetString());
+        Assert.IsTrue(document.RootElement.GetProperty("success").GetBoolean());
+        registry.Verify();
+        factory.Verify();
+        provider.Verify();
+    }
+
+    [TestMethod]
+    public async Task SaveDraft_Reply_DerivesAddressingFromOriginalMessage()
+    {
+        var account = TestData.CreateAccount(id: "sender", provider: "microsoft365");
+        var registry = new IAccountRegistryCreateExpectations();
+        registry.Setups.GetAccountAsync("sender").ReturnValue(Task.FromResult<AccountInfo?>(account));
+        var provider = new IProviderServiceCreateExpectations();
+        provider.Setups.SaveDraftAsync(
+                "sender", Arg.Any<string?>(), Arg.Any<string?>(), "Thanks", "html",
+                Arg.Any<List<string>?>(), "message-1", true,
+                Arg.Any<CancellationToken>())
+            .ReturnValue(Task.FromResult("draft-reply-1"));
+        var factory = new IProviderServiceFactoryCreateExpectations();
+        factory.Setups.GetProvider("microsoft365").ReturnValue(provider.Instance());
+        var tool = new SaveDraftTool(registry.Instance(), factory.Instance(), NullLogger<SaveDraftTool>.Instance);
+
+        var json = await tool.SaveDraft(
+            "sender", "Thanks", replyToEmailId: "message-1", replyAll: true);
+        using var document = JsonDocument.Parse(json);
+
+        Assert.AreEqual("draft-reply-1", document.RootElement.GetProperty("draftReference").GetString());
+        Assert.AreEqual("message-1", document.RootElement.GetProperty("replyToEmailId").GetString());
+        Assert.IsTrue(document.RootElement.GetProperty("replyAll").GetBoolean());
+        registry.Verify();
+        factory.Verify();
+        provider.Verify();
+    }
+
+    [TestMethod]
+    public async Task SaveDraft_ReadOnlyAccount_Throws()
+    {
+        var account = TestData.CreateAccount(
+            id: "read-only",
+            provider: "google",
+            permissions: AccountPermissions.None.With(AccountPermission.EmailRead, true));
+        var registry = new IAccountRegistryCreateExpectations();
